# Copy to .env and fill in real values before deploying for real:
#   cp .env.example .env
#
# The placeholder values below are enough for `docker compose up` to boot
# successfully and accept submissions end-to-end for the example forms in
# config.example/ (channel config is validated, and pre-parsed templates
# compile, at startup) — actual delivery attempts will just fail with a
# connection/auth error until you replace them with real credentials.

SMTP_PASSWORD=changeme

FORM_CONTACT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/000000000000000000/placeholder
FORM_NEWSLETTER_DISCORD_WEBHOOK=https://discord.com/api/webhooks/000000000000000000/placeholder
FORM_SUPPORT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/000000000000000000/placeholder

# Only needed if you flip captcha/spam_filter/spam-review-discord to
# enabled: true in the example forms (all disabled by default):
# FORM_CONTACT_TURNSTILE_SECRET=
# FORM_SUPPORT_TURNSTILE_SECRET=
# FORM_CONTACT_SPAM_DISCORD_WEBHOOK=
# SPAM_FILTER_API_KEY=

# Only needed if you set rate_limit.backend: valkey in config.yaml:
# VALKEY_PASSWORD=
